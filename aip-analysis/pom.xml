<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>aip</groupId>
    <artifactId>aip-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>aip-analysis</artifactId>
  <packaging>jar</packaging>

  <name>aip-analysis</name>
  <description>
    Deterministic, snapshot-driven Analysis Framework: registered
    Analyzers producing durable, traceable Analysis Results from a CSM
    Snapshot's Analysis View. See
    openspec/changes/define-analysis-framework/ and
    openspec/changes/implement-analysis-framework/. Depends on
    aip-core only — per design.md Decision 1, this module SHALL NOT
    depend on aip-csm-builder, aip-analyzer, or any Policy/Rule Model
    module.
  </description>

  <dependencies>
    <dependency>
      <groupId>aip</groupId>
      <artifactId>aip-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Dependency-graph guard (design.md Decision 1; tasks.md 15.1):
        fails the build if this module's resolved dependency graph
        ever contains anything other than aip-core.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>check-module-dependencies</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${project.basedir}/../scripts/check-module-dependencies.sh</executable>
              <arguments>
                <argument>aip-analysis</argument>
                <argument>aip:aip-core</argument>
              </arguments>
            </configuration>
          </execution>
          <!--
            Fixture-package scope guard (design.md Decision 6;
            tasks.md 13.2): fails the build if any production source
            under src/main/java references the test-only
            fixture-building package.
          -->
          <execution>
            <id>check-fixture-package-scope</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${project.basedir}/../scripts/check-fixture-package-scope.sh</executable>
              <arguments>
                <argument>aip-analysis</argument>
                <argument>aip.analysis.test.fixtures</argument>
              </arguments>
            </configuration>
          </execution>
          <!--
            No-AI/heuristic-import guard (tasks.md 11.1): fails the
            build if production source imports a randomness API or a
            known AI/LLM SDK package.
          -->
          <execution>
            <id>check-no-ai-heuristic-imports</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${project.basedir}/../scripts/check-no-ai-heuristic-imports.sh</executable>
              <arguments>
                <argument>aip-analysis</argument>
              </arguments>
            </configuration>
          </execution>
          <!--
            No-concurrency-infrastructure guard (design.md Decision 6;
            tasks.md 15.2): fails the build if the v1 orchestrator
            introduces a thread pool or executor service.
          -->
          <execution>
            <id>check-no-concurrency-infrastructure</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${project.basedir}/../scripts/check-no-concurrency-infrastructure.sh</executable>
              <arguments>
                <argument>aip-analysis</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
